{
  "manifest_version": 3,

  "name": "Facebook Notifications",
  "description": "Shows Facebook notifications in your browser",
  "version": "0.2",
  "icons": {
    "16": "images/icon.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "action": {
    "default_icon": "images/icon.png",
    "default_popup": "popup.html",
    "default_title": "Facebook Notifications"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/notifications"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "notifications",
    "activeTab",
    "storage",
    "tabs",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
